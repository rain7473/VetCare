/* ============================================================
   VetCare — Hoja de estilos base (QSS)
   Identidad: teal oscuro / turquesa / cyan / mint sobre fondos
   claros, cards blancas y texto slate.
   Paleta (ver config/constants.py):
     Primary Dark #006978 | Primary #008FA3 | Secondary #14B8C4
     Mint #63D7B0 | Background #F5FAFC | Card #FFFFFF
     Text Dark #102A43 | Muted #6B8194
   ============================================================ */

QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
    color: #102A43;
}

QLabel#vetIcon { background: transparent; border: none; padding: 0; }

QMainWindow, QDialog, QWidget#appBackground {
    background-color: #F5FAFC;
}

/* ---------- Cards ---------- */

QFrame[card="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E3EEF3;
    border-radius: 16px;
}

/* ---------- Botones ---------- */

QPushButton {
    background-color: #008FA3;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 22px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #14B8C4;
}

QPushButton:pressed {
    background-color: #006978;
}

QPushButton:disabled {
    background-color: #C3D4DD;
    color: #F5FAFC;
}

QPushButton[variant="secondary"] {
    background-color: transparent;
    color: #008FA3;
    border: 2px solid #008FA3;
}

QPushButton[variant="secondary"]:hover {
    background-color: #E6F6F8;
}

QPushButton[variant="secondary"]:pressed {
    background-color: #CDEDF1;
}

QPushButton#selectorAddButton {
    min-width: 36px;
    max-width: 36px;
    padding: 8px 0;
    font-size: 19px;
    font-weight: 700;
}

QLabel#selectorMessage {
    color: #E5484D;
    font-size: 12px;
    background: transparent;
}

/* ---------- Campos de texto ---------- */

QLineEdit, QTextEdit, QComboBox, QDateEdit, QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #C3D4DD;
    border-radius: 10px;
    padding: 9px 12px;
    selection-background-color: #14B8C4;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus,
QDateEdit:focus, QDateTimeEdit:focus {
    border: 2px solid #008FA3;
}

QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled {
    background-color: #EEF4F7;
    color: #6B8194;
}

/* ---------- Tablas ---------- */

QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F7FBFC;
    border: 1px solid #E3EEF3;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #D3F0F4;
    selection-color: #102A43;
}

QTableView::item {
    padding: 8px 10px;
    border: none;
}

/* QCalendarWidget contiene una tabla; las celdas no son filas de CRUD. */
QCalendarWidget QTableView {
    background: white; color: #102A43; font-size: 13px;
    selection-background-color: #008FA3; selection-color: white;
}
QCalendarWidget QTableView::item { padding: 0px; margin: 0px; border: none; }
QCalendarWidget QToolButton { padding: 4px; color: white; background: #006978; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #006978; }

QHeaderView::section {
    background-color: #EEF6F8;
    color: #006978;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid #E3EEF3;
    padding: 10px 10px;
}

QTableView QTableCornerButton::section {
    background-color: #EEF6F8;
    border: none;
}

/* ---------- Tooltips ---------- */

QToolTip {
    background-color: #102A43;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ---------- Títulos de pantalla y mensajes ---------- */

QLabel#screenTitle {
    color: #006978;
    font-size: 26px;
    font-weight: 800;
    background: transparent;
}

QLabel#screenSubtitle {
    color: #6B8194;
    font-size: 15px;
    background: transparent;
}

QLabel#errorLabel {
    color: #E5484D;
    font-size: 13px;
    background: transparent;
}

/* ============================================================
   Shell principal: sidebar, topbar, páginas
   ============================================================ */

QFrame#sidebar {
    background-color: #006978;
    border: none;
}

QLabel#sidebarTitle {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 800;
    background: transparent;
}

QLabel#sidebarSubtitle {
    color: #9FD4DC;
    font-size: 12px;
    background: transparent;
}

QLabel#sidebarLogo {
    background-color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 19px;
}

QLabel#sidebarFooter {
    color: #9FD4DC;
    font-size: 11px;
    font-style: italic;
    background: transparent;
    padding: 6px;
}

QPushButton[nav="true"] {
    background-color: transparent;
    color: #CFE9EE;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton[nav="true"]:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: #FFFFFF;
}

QPushButton[nav="true"]:checked {
    background-color: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
    font-weight: 700;
}

QFrame#topbar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E3EEF3;
}

QLineEdit#globalSearch {
    background-color: #F0F6F9;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 6px 16px;
}

QLineEdit#globalSearch:focus {
    border: 2px solid #14B8C4;
    background-color: #FFFFFF;
}

/* Popups explícitamente claros: no heredan el tema oscuro de Windows. */
QAbstractItemView#globalSearchPopup {
    background-color: #FFFFFF;
    alternate-background-color: #F7FBFC;
    color: #102A43;
    border: 1px solid #BFD9E2;
    border-radius: 8px;
    outline: 0;
    selection-background-color: #D3F0F4;
    selection-color: #006978;
    padding: 4px;
}

QAbstractItemView#globalSearchPopup::item {
    background-color: #FFFFFF;
    color: #102A43;
    min-height: 34px;
    padding: 5px 10px;
    border-radius: 5px;
}

QAbstractItemView#globalSearchPopup::item:hover,
QAbstractItemView#globalSearchPopup::item:selected {
    background-color: #D3F0F4;
    color: #006978;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    alternate-background-color: #F7FBFC;
    color: #102A43;
    border: 1px solid #BFD9E2;
    outline: 0;
    selection-background-color: #D3F0F4;
    selection-color: #006978;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 8px;
}

QPushButton#notifButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    padding: 0;
}

QPushButton#notifButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
}

QPushButton#notifButton:hover {
    background-color: #EEF6F8;
}

QFrame#userChip {
    background-color: transparent;
    border: none;
    border-radius: 12px;
}

QLabel#avatarBadge {
    background-color: #14B8C4;
    color: #FFFFFF;
    border-radius: 18px;
    font-size: 13px;
    font-weight: 700;
}

QLabel#topbarUserName {
    color: #102A43;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#topbarUserRole {
    color: #6B8194;
    font-size: 11px;
    background: transparent;
}

QPushButton#userMenuButton {
    background-color: transparent;
    color: #6B8194;
    border: none;
    font-size: 14px;
    padding: 0;
}

QPushButton#userMenuButton::menu-indicator {
    image: none;
}

QPushButton#userMenuButton:hover {
    color: #006978;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E3EEF3;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 6px;
    color: #102A43;
}

QMenu::item:selected {
    background-color: #E6F6F8;
    color: #006978;
}

QMenu::item:disabled {
    color: #6B8194;
    background-color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #E3EEF3;
    margin: 5px 8px;
}

QWidget#pageArea {
    background-color: #F5FAFC;
}

QLabel#pageTitle {
    color: #006978;
    font-size: 22px;
    font-weight: 800;
    background: transparent;
}

QLabel#cardTitle {
    color: #006978;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#statusBadge {
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#statTitle {
    color: #6B8194;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#statValue {
    color: #102A43;
    font-size: 26px;
    font-weight: 800;
    background: transparent;
}

QLabel#statIcon {
    font-size: 22px;
    background: transparent;
}

QLabel#statDetail, QLabel#dashboardEmpty {
    color: #6B8194;
    font-size: 11px;
    background: transparent;
}

QLabel#dashboardItem {
    color: #334E68;
    background-color: #F7FBFC;
    border-left: 3px solid #14B8C4;
    border-radius: 6px;
    padding: 7px 9px;
    font-size: 12px;
}

QLabel#dashboardItem[severity="critical"] { border-left-color: #E5484D; }
QLabel#dashboardItem[severity="high"] { border-left-color: #F28C28; }
QLabel#dashboardItem[severity="medium"] { border-left-color: #E4B93F; }
QLabel#dashboardItem[severity="low"] { border-left-color: #63D7B0; }

/* Dashboard analítico: estilos limitados a sus componentes. */
QScrollArea#dashboardPanelScroll, QWidget#dashboardPanelBody { background: #FFFFFF; border: none; }
QFrame#dashboardStatCard:hover, QFrame#dashboardStatCard:focus {
    border: 1px solid #14B8C4;
    background: #F7FDFD;
}
QLabel#dashboardCaption {
    font-size: 12px;
    color: #6B8194;
    background: transparent;
}
QLabel#dashboardEmptyChart {
    background: #F7FBFC;
    color: #6B8194;
    border: 1px dashed #D4E5ED;
    border-radius: 12px;
    padding: 18px;
}
QFrame#dashboardEvent {
    background: #F7FBFC;
    border: none;
    border-left: 3px solid #63D7B0;
    border-radius: 6px;
}
QFrame#dashboardEvent[severity="critical"] { border-left-color: #E5484D; background: #FFF4F4; }
QFrame#dashboardEvent[severity="high"] { border-left-color: #F28C28; }
QFrame#dashboardEvent[severity="medium"] { border-left-color: #E4B93F; }
QLabel#dashboardEventTitle { font-size: 13px; font-weight: 600; background: transparent; }
QPushButton#dashboardLink { background: transparent; color: #008FA3; padding: 2px 0; font-size: 12px; }
QPushButton#dashboardLink:hover { color: #006978; text-decoration: underline; }

QLabel#profileName {
    color: #102A43;
    font-size: 20px;
    font-weight: 800;
    background: transparent;
}

QLabel#photoPreview {
    background-color: #E6F6F8;
    border: 1px solid #C9E8EC;
    border-radius: 12px;
    font-size: 30px;
}

/* Perfil de Mascotas: estilos confinados al panel derecho. */
QFrame#petProfilePanel {
    background-color: #FFFFFF;
    border: 1px solid #DCEAF0;
    border-radius: 14px;
}
QFrame#petProfileHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #F0FAFE, stop:1 #DEF2F9);
    border-bottom: 1px solid #D5ECF3;
    border-top-left-radius: 13px;
    border-top-right-radius: 13px;
}
QLabel#petProfilePhoto {
    background-color: #E6F4F8;
    border: 2px solid #FFFFFF;
    border-radius: 13px;
    font-size: 28px;
}
QPushButton#petPhotoButton {
    background-color: #006978;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 0;
    font-size: 12px;
}
QLabel#petProfileName {
    font-size: 24px;
    font-weight: 800;
    color: #102A43;
    background: transparent;
}
QPushButton#petHeaderEdit {
    background-color: #FFFFFF;
    border: 1px solid #D4EAF0;
    border-radius: 8px;
    padding: 3px;
}
QPushButton#petHeaderEdit:hover { background-color: #CDEDF1; }
QLabel#petHeaderMetric {
    font-size: 12px;
    color: #294D63;
    background: transparent;
}
QLabel#petProfileSubtle {
    color: #617B8E;
    font-size: 12px;
    background: transparent;
}
QLabel#petStatusBadge {
    color: #006978;
    background-color: #DDF6ED;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: 700;
}
QLabel#petStatusBadge[petStatus="INACTIVE"] {
    color: #9B5A00;
    background-color: #FFF0CB;
}
QLabel#petStatusBadge[petStatus="DECEASED"] {
    color: #B33F46;
    background-color: #FDE9EA;
}
QTabWidget#petProfileTabs::pane {
    border: none;
    background-color: #F9FCFD;
}
QTabWidget#petProfileTabs, QTabBar#petProfileTabBar {
    background-color: #F8FCFD;
    border: none;
}
QTabBar#petProfileTabBar::tear { background-color: #F8FCFD; }
QScrollArea#petProfileScroll {
    background-color: #F8FCFD;
    border: none;
}
QFrame#petProfilePanel QScrollBar:vertical {
    background-color: #EEF6F9;
    width: 8px;
    margin: 0;
    border: none;
}
QFrame#petProfilePanel QScrollBar::handle:vertical {
    background-color: #BCD8E2;
    border-radius: 4px;
    min-height: 28px;
}
QFrame#petProfilePanel QScrollBar::add-line:vertical,
QFrame#petProfilePanel QScrollBar::sub-line:vertical { height: 0; }
QFrame#petProfilePanel QScrollBar::add-page:vertical,
QFrame#petProfilePanel QScrollBar::sub-page:vertical { background: transparent; }
QTabWidget#petProfileTabs QTabBar::tab {
    color: #627D90;
    background-color: #F4FAFC;
    padding: 10px 5px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 11px;
}
QTabWidget#petProfileTabs QTabBar::tab:selected {
    color: #007E91;
    background-color: #FFFFFF;
    border-bottom: 2px solid #14B8C4;
    font-weight: 700;
}
QWidget#petProfileContent { background-color: #F9FCFD; }
QWidget#petNotesColumn { background: transparent; }
QFrame#petInfoCard {
    background-color: #FFFFFF;
    border: 1px solid #E2EDF1;
    border-radius: 11px;
}
QLabel#petCardHeading {
    color: #006978;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
QLabel#petFieldCaption {
    color: #637E91;
    font-size: 11px;
    background: transparent;
}
QLabel#petFieldValue {
    color: #102A43;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}
QFrame#petFieldSeparator {
    background-color: #EEF3F6;
    border: none;
}
QLabel#petProfileNote, QLabel#petProfileEmpty {
    color: #627D90;
    font-size: 12px;
    background: transparent;
}
QLabel#petProfileEmpty { padding: 12px; }
QPushButton#petProfileLink {
    color: #008FA3;
    background: transparent;
    border: none;
    padding: 4px 1px;
    font-size: 11px;
    text-align: left;
}
QPushButton#petProfileLink:hover { color: #006978; }
QPushButton#petProfileLink:disabled { color: #A1B6C0; }
QFrame#petProfileFooter {
    background-color: #FFFFFF;
    border-top: 1px solid #DFEBF0;
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
}
QPushButton#petQuickAction {
    background-color: #008FA3;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 8px 4px;
    font-size: 11px;
    font-weight: 700;
}
QPushButton#petQuickAction:hover { background-color: #006978; }
QPushButton#petQuickAction:disabled {
    background-color: #CBDDE3;
    color: #F8FBFC;
}

/* ============================================================
   Ventana de inicio (views/startup)
   ============================================================ */

QLabel#logoBadge {
    background-color: #008FA3;
    color: #FFFFFF;
    border-radius: 36px;
    font-size: 30px;
}

QLabel#appTitle {
    color: #006978;
    font-size: 36px;
    font-weight: 800;
    background: transparent;
}

QLabel#appSubtitle {
    color: #102A43;
    font-size: 16px;
    background: transparent;
}

QFrame#accentLine {
    background-color: #63D7B0;
    border: none;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
}

QLabel#appTagline {
    color: #008FA3;
    font-size: 14px;
    font-style: italic;
    background: transparent;
}

QLabel#versionLabel {
    color: #6B8194;
    font-size: 12px;
    background: transparent;
}
