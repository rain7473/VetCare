/* ============================================================
   VetCare — Hoja de estilos base (QSS)
   Identidad: teal oscuro / turquesa / cyan / mint sobre fondos
   claros, cards blancas y texto slate.
   Paleta (ver config/constants.py):
     Primary Dark #006978 | Primary #008FA3 | Secondary #14B8C4
     Mint #63D7B0 | Background #F5FAFC | Card #FFFFFF
     Text Dark #102A43 | Muted #6B8194
   ============================================================ */

QWidget {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 14px;
    color: #102A43;
}

QMainWindow, QDialog, QWidget#appBackground {
    background-color: #F5FAFC;
}

/* ---------- Cards ---------- */

QFrame[card="true"] {
    background-color: #FFFFFF;
    border: 1px solid #E3EEF3;
    border-radius: 16px;
}

/* ---------- Botones ---------- */

QPushButton {
    background-color: #008FA3;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 22px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #14B8C4;
}

QPushButton:pressed {
    background-color: #006978;
}

QPushButton:disabled {
    background-color: #C3D4DD;
    color: #F5FAFC;
}

QPushButton[variant="secondary"] {
    background-color: transparent;
    color: #008FA3;
    border: 2px solid #008FA3;
}

QPushButton[variant="secondary"]:hover {
    background-color: #E6F6F8;
}

QPushButton[variant="secondary"]:pressed {
    background-color: #CDEDF1;
}

/* ---------- Campos de texto ---------- */

QLineEdit, QTextEdit, QComboBox, QDateEdit, QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #C3D4DD;
    border-radius: 10px;
    padding: 9px 12px;
    selection-background-color: #14B8C4;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus,
QDateEdit:focus, QDateTimeEdit:focus {
    border: 2px solid #008FA3;
}

QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled {
    background-color: #EEF4F7;
    color: #6B8194;
}

/* ---------- Tablas ---------- */

QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F7FBFC;
    border: 1px solid #E3EEF3;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: #D3F0F4;
    selection-color: #102A43;
}

QTableView::item {
    padding: 8px 10px;
    border: none;
}

QHeaderView::section {
    background-color: #EEF6F8;
    color: #006978;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid #E3EEF3;
    padding: 10px 10px;
}

QTableView QTableCornerButton::section {
    background-color: #EEF6F8;
    border: none;
}

/* ---------- Tooltips ---------- */

QToolTip {
    background-color: #102A43;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ---------- Títulos de pantalla y mensajes ---------- */

QLabel#screenTitle {
    color: #006978;
    font-size: 26px;
    font-weight: 800;
    background: transparent;
}

QLabel#screenSubtitle {
    color: #6B8194;
    font-size: 15px;
    background: transparent;
}

QLabel#errorLabel {
    color: #E5484D;
    font-size: 13px;
    background: transparent;
}

/* ============================================================
   Shell principal: sidebar, topbar, páginas
   ============================================================ */

QFrame#sidebar {
    background-color: #006978;
    border: none;
}

QLabel#sidebarTitle {
    color: #FFFFFF;
    font-size: 21px;
    font-weight: 800;
    background: transparent;
    padding-left: 6px;
}

QLabel#sidebarSubtitle {
    color: #9FD4DC;
    font-size: 12px;
    background: transparent;
    padding-left: 6px;
}

QLabel#sidebarFooter {
    color: #9FD4DC;
    font-size: 11px;
    font-style: italic;
    background: transparent;
    padding: 6px;
}

QPushButton[nav="true"] {
    background-color: transparent;
    color: #CFE9EE;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
}

QPushButton[nav="true"]:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: #FFFFFF;
}

QPushButton[nav="true"]:checked {
    background-color: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
    font-weight: 700;
}

QFrame#topbar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E3EEF3;
}

QLineEdit#globalSearch {
    background-color: #F0F6F9;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 6px 16px;
}

QLineEdit#globalSearch:focus {
    border: 2px solid #14B8C4;
    background-color: #FFFFFF;
}

QPushButton#notifButton {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    padding: 0;
}

QPushButton#notifButton:hover {
    background-color: #EEF6F8;
}

QFrame#userChip {
    background-color: transparent;
    border: none;
    border-radius: 12px;
}

QLabel#avatarBadge {
    background-color: #14B8C4;
    color: #FFFFFF;
    border-radius: 18px;
    font-size: 13px;
    font-weight: 700;
}

QLabel#topbarUserName {
    color: #102A43;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#topbarUserRole {
    color: #6B8194;
    font-size: 11px;
    background: transparent;
}

QPushButton#userMenuButton {
    background-color: transparent;
    color: #6B8194;
    border: none;
    font-size: 14px;
    padding: 0;
}

QPushButton#userMenuButton::menu-indicator {
    image: none;
}

QPushButton#userMenuButton:hover {
    color: #006978;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E3EEF3;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 6px;
    color: #102A43;
}

QMenu::item:selected {
    background-color: #E6F6F8;
    color: #006978;
}

QWidget#pageArea {
    background-color: #F5FAFC;
}

QLabel#pageTitle {
    color: #006978;
    font-size: 22px;
    font-weight: 800;
    background: transparent;
}

QLabel#statTitle {
    color: #6B8194;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#statValue {
    color: #102A43;
    font-size: 26px;
    font-weight: 800;
    background: transparent;
}

QLabel#statIcon {
    font-size: 22px;
    background: transparent;
}

/* ============================================================
   Ventana de inicio (views/startup)
   ============================================================ */

QLabel#logoBadge {
    background-color: #008FA3;
    color: #FFFFFF;
    border-radius: 36px;
    font-size: 30px;
}

QLabel#appTitle {
    color: #006978;
    font-size: 36px;
    font-weight: 800;
    background: transparent;
}

QLabel#appSubtitle {
    color: #102A43;
    font-size: 16px;
    background: transparent;
}

QFrame#accentLine {
    background-color: #63D7B0;
    border: none;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
}

QLabel#appTagline {
    color: #008FA3;
    font-size: 14px;
    font-style: italic;
    background: transparent;
}

QLabel#versionLabel {
    color: #6B8194;
    font-size: 12px;
    background: transparent;
}
